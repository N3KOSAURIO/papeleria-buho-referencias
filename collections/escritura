 parece un soufflé esponjoso.\u003c\/p\u003e\n\u003cp\u003eSu diámetro de bola es de 0.8 mm.\u003c\/p\u003e\n\u003cp\u003eAl escribir con ellos debes dejar secar para que aparezca ese efecto con volumen tan lindo. Se recomienda usarlos despacio para que la tinta forme la línea perfectamente y en algunas superficies puede tardar unos 10 minutos en secarse completamente, por lo que no es recomendado para escrituras extensas.\u003cbr\u003e\u003c\/p\u003e\n\u003cp\u003eSe puede usar en otras superficies lisas que no sean papel (como vidrio, plástico o metal) y en papeles oscuros deja un acabado especialmente bonito.\u003c\/p\u003e","published_at":"2023-01-28T11:05:54+01:00","created_at":"2023-01-27T13:29:56+01:00","vendor":"Sakura","type":"Bolígrafos","tags":["3D","bolígrafo","caligrafía","destacados","dibujo","gel","gelly roll","lettering","mate","sakura","soufflé"],"price":180,"price_min":180,"price_max":180,"available":true,"price_varies":false,"compare_at_price":null,"compare_at_price_min":0,"compare_at_price_max":0,"compare_at_price_varies":false,"variants":[{"id":44342480306492,"title":"Yellow","option1":"Yellow","option2":null,"option3":null,"sku":"PGB#903","requires_shipping":true,"taxable":true,"featured_image":{"id":49630382522703,"product_id":8099863691580,"position":4,"created_at":"2023-04-28T22:35:10+02:00","updated_at":"2023-05-22T13:26:04+02:00","alt":null,"width":1048,"height":1048,"src":"\/\/suikawaii.com\/cdn\/shop\/products\/SAKURA_BoligrafodeGelSouffleEfecto3DMateyellow.jpg?v=1684754764","variant_ids":[44342480306492]},"available":true,"name":"SAKURA | Bolígrafo de Gel Soufflé Efecto 3D Mate - Yellow","public_title":"Yellow","options":["Yellow"],"price":180,"weight":0,"compare_at_price":null,"inventory_management":"shopify","barcode":"4901881120367","featured_media":{"alt":null,"id":42227655278927,"position":4,"preview_image":{"aspect_ratio":1.0,"height":1048,"width":1048,"src":"\/\/suikawaii.com\/cdn\/shop\/products\/SAKURA_BoligrafodeGelSouffleEfec